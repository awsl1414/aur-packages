# Binary / archive files
*.tar
*.tar.*
*.jar
*.exe
*.msi
*.deb
*.zip
*.tgz
*.AppImage
*.log
*.log.*
*.sig

# AUR build artifacts
pkg/
src/

# Downloaded package files
scripts/downloads/

# aria2c control files
*.aria2

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/

# Claude Code local settings (user-specific)
.claude/settings.local.json
.claude/plans/

# macOS
.DS_Store

# graphify 知识图谱产物
# 保留 graph.json 与 GRAPH_REPORT.md 作为分析快照；其余均为可重新生成的
# 机器特定状态 / 中间临时文件，不应提交（cache/、cost.json、.graphify_* 等）
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
